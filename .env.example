# ─────────────────────────────────────────────────────────────────────
# Docker Compose Environment Variables — HDB Interior Design
# ─────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in real values.
# This file provides vars that docker-compose.yml interpolates.
# Backend-specific vars live in backend/.env instead.
# ─────────────────────────────────────────────────────────────────────

# === General ===
NODE_ENV=development
APP_URL=http://localhost

# === Database (PostgreSQL 16) ===
DB_USER=hdb_app
DB_PASSWORD=changeme
DB_NAME=hdb_interior_design

# === Redis 7 ===
REDIS_PASSWORD=changeme

# === Auth (NextAuth.js + Google OAuth) ===
NEXTAUTH_SECRET=your-generated-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# === Backend (see backend/.env for full list) ===
# BACKEND_PORT=4000
