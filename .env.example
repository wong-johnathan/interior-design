# HDB Interior Design - Environment Template
# Copy to .env and fill in real values.

# === General ===
NODE_ENV=production
APP_URL=http://localhost

# === Database (PostgreSQL) ===
DB_USER=hdb_app
DB_PASSWORD=changeme
DB_NAME=hdb_interior_design
DATABASE_URL=postgresql://${DB_USER}:***@postgres:5432/${DB_NAME}?schema=public
DIRECT_URL=postgresql://${DB_USER}:***@postgres:5432/${DB_NAME}?schema=public

# === Redis ===
REDIS_URL=redis://redis:***@hdb.com}
REDIS_PASSWORD=changeme

# === Auth ===
NEXTAUTH_SECRET=your-generated-secret-here
NEXTAUTH_URL=${APP_URL}
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# === Backend ===
CORS_ORIGIN=${APP_URL}
BACKEND_PORT=4000
FRONTEND_INTERNAL_URL=http://frontend:3000

# === Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# === Cloudflare R2 ===
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=hdb-interior-design

# === Dev-Only: pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@hdb-interior.com
PGADMIN_DEFAULT_PASSWORD=admin

# === Dev-Only: MinIO (R2 Emulator) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
