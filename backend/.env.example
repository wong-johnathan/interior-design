# ─────────────────────────────────────────────────────────────────────
# Backend Environment Variables — HDB Interior Design
# ─────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in real values.
# This file is referenced by docker-compose.yml via env_file.
# ─────────────────────────────────────────────────────────────────────

# === Database (PostgreSQL 16) ===
# Hostname "postgres" resolves via Docker internal DNS
DATABASE_URL=postgresql://hdb_app:changeme@postgres:5432/hdb_interior_design?schema=public
DIRECT_URL=postgresql://hdb_app:changeme@postgres:5432/hdb_interior_design?schema=public

# === Redis 7 ===
REDIS_URL=redis://:changeme@redis:6379
REDIS_PASSWORD=changeme

# === General ===
NODE_ENV=development
PORT=4000
HOSTNAME=0.0.0.0
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost

# === Auth (NextAuth.js) ===
NEXTAUTH_SECRET=your-generated-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# === Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# === Cloudflare R2 (or MinIO for dev) ===
# For dev with MinIO: R2_ENDPOINT=http://minio:9000
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=hdb-interior-design

# === Dev-Only: MinIO Credentials (for R2 emulation) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
